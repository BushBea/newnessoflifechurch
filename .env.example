# Copy this file to .env and fill in real values before running the server.
# Never commit your real .env file.

# Port the API server listens on
PORT=4000

# Set to "production" when deployed
NODE_ENV=development

# Long, random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# Comma-separated list of origins allowed to call this API with credentials.
# Include the exact URL(s) your frontend is served from.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Seed data: the one admin account created the first time you run `npm run seed`.
ADMIN_NAME=Church Admin
ADMIN_EMAIL=admin@newnessoflife.org
ADMIN_PASSWORD=change-this-strong-password

# Path to the SQLite database file. On Render/Railway, point this at a
# persistent disk/volume mount (see README) so data survives redeploys.
DATABASE_FILE=./data/church.db
